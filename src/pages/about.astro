---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import avatar from '../assets/avatar.webp';
import { site, socials } from '../config';
import ContactForm from '../components/ContactForm.astro';
import { pageSchema } from '../lib/schema';

// TODO(stuart): rewrite these in your own voice — the shape is right,
// the specifics are placeholders.
const timeline = [
  {
    period: 'In progress',
    title: 'MSc Game Development & XR',
    body: 'Moving from static visuals into interactive and spatial work — engine programming, real-time rendering, and XR interaction design.',
    discipline: 'games',
  },
  
  {
    period: 'Bachelor of Business (Hons)',
    title: 'Digital Marketing',
    body: 'Brand strategy, consumer behaviour and campaign planning. The reason the design work is built around an audience rather than a mood board.',
    discipline: 'writing',
  },
  {
    period: 'Professional Diploma',
    title: 'Graphic Design',
    body: 'Formal grounding in typography, layout, colour and production — the craft underneath everything in the design archive.',
    discipline: 'design',
  },
] as const;

const experience = [
  {
    period: 'Apr 2026 – Present',
    title: 'Marketing Executive — Beara Beara Ltd',
    body: 'Multi-channel marketing, ecommerce and lifecycle ownership for an independent leather goods brand across the UK and Ireland — rebuilt GA4/GTM tracking and lifted key events 84% quarter over quarter.',
    discipline: 'writing',
  },
  {
    period: 'Oct 2025 – Apr 2026',
    title: 'Social Media Content Creator — SuperValu, Monaghan',
    body: "A project-based content initiative delivered alongside the Fleming's role — short-form TikTok and Facebook content for the SuperValu Monaghan store, with one video passing 60K views.",
    discipline: 'writing',
  },
  {
    period: 'Jul 2025 – Apr 2026',
    title: "E-Commerce & Digital Marketing Executive — Fleming's Department Store",
    body: 'Sole digital marketing function for a multi-department retailer — SEO, paid media, email and narrative-led video campaigns that drove +108% Q4 revenue and +245% order growth.',
    discipline: 'writing',
  },
  {
    period: 'Sep 2024 – Jul 2025',
    title: 'Digital Marketing & Strategy Consultant — Mersus Technologies',
    body: 'A capstone engagement with a B2B VR training company — website/UX redesign, brand refresh and an organic LinkedIn strategy that lifted LinkedIn-driven active users 183% against a 5.6% industry benchmark.',
    discipline: 'writing',
  },
  {
    period: 'Jun 2024 – Jul 2025',
    title: 'Social Media Coordinator — Marks & Spencer, Athlone',
    body: 'Created and managed TikTok and Facebook content for the M&S Athlone store, including coverage of two in-store fundraising events for Jigsaw.',
    discipline: 'writing',
  },
] as const;

const certifications = [
  { name: 'Certified Digital Marketing Professional (CDMP)', issuer: 'Digital Marketing Institute' },
  { name: 'Fundamentals of Digital Marketing', issuer: 'Google Digital Garage' },
  { name: 'Microsoft Office Specialist – Master', issuer: 'Microsoft' },
  { name: 'Microsoft Excel Expert', issuer: 'Microsoft' },
  { name: 'Microsoft Word Expert', issuer: 'Microsoft' },
  { name: 'QQI Level 5 Major Award — E-Business', issuer: 'QQI' },
  { name: 'QQI Level 5 Major Award — Information Processing', issuer: 'QQI' },
] as const;

const capabilities = [
  'Brand identity & systems',
  'Campaign art direction',
  'Print & production artwork',
  'Motion & social assets',
  'Unity / real-time 3D',
  'XR interaction prototyping',
];
---

<Base
  title="About"
  description="Stuart May — marketing graduate, certified graphic designer, MSc game development and XR student."
  schema={pageSchema('About', '/about', 'About Stuart May: background, experience and how to get in touch.', 'ProfilePage')}
>
  <div class="mx-auto max-w-4xl px-4 py-20 sm:px-6 sm:py-28">
    <header
      class="flex flex-col-reverse items-center gap-8 sm:flex-row sm:items-center sm:justify-between"
      data-intro
    >
      <div class="max-w-xl">
        <h1 class="text-4xl sm:text-5xl">About</h1>
        <div class="prose mt-7 text-justify">
          <p>
            I'm {site.name}. I started in marketing, learned to make the artwork myself, and I'm now
            studying game development and XR — which is really the same job with an extra dimension
            and a frame budget.
          </p>
          <p>
            Most of what's in the archive was made under a brief: a launch, a rebrand, a campaign
            with a date attached. The games and XR work is newer and mostly academic, with playable
            builds on itch.io where a build exists.
          </p>
        </div>
      </div>

      <Image
        src={avatar}
        alt={`Illustrated portrait of ${site.name}`}
        width={384}
        height={384}
        class="size-48 shrink-0 rounded-full object-cover sm:size-56 lg:size-64"
      />
    </header>

    <section class="mt-20" aria-labelledby="background">
      <h2 id="background" class="text-2xl" data-reveal>Background</h2>
      <ol class="mt-8 flex flex-col gap-4" data-stagger>
        {
          timeline.map((item) => (
            <li class="glass rounded-2xl p-6" data-reveal data-discipline={item.discipline}>
              <p class="accent-text text-xs font-medium uppercase tracking-[0.16em]">
                {item.period}
              </p>
              <h3 class="mt-2 text-lg">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-(--color-muted)">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-20" aria-labelledby="experience">
      <h2 id="experience" class="text-2xl" data-reveal>Experience</h2>
      <ol class="mt-8 flex flex-col gap-4" data-stagger>
        {
          experience.map((item) => (
            <li class="glass rounded-2xl p-6" data-reveal data-discipline={item.discipline}>
              <p class="accent-text text-xs font-medium uppercase tracking-[0.16em]">
                {item.period}
              </p>
              <h3 class="mt-2 text-lg">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-(--color-muted)">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-20" aria-labelledby="certifications">
      <h2 id="certifications" class="text-2xl" data-reveal>Certifications</h2>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2" data-reveal>
        {
          certifications.map((c) => (
            <li class="flex items-start gap-3 rounded-xl border border-white/8 bg-white/3 px-4 py-3">
              <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-(--color-accent)" aria-hidden="true" />
              <span>
                <span class="block text-sm text-(--color-fg)">{c.name}</span>
                <span class="block text-xs text-(--color-faint)">{c.issuer}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-20" aria-labelledby="capabilities">
      <h2 id="capabilities" class="text-2xl" data-reveal>What I do</h2>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2" data-reveal>
        {
          capabilities.map((c) => (
            <li class="flex items-center gap-3 rounded-xl border border-white/8 bg-white/3 px-4 py-3 text-sm text-(--color-muted)">
              <span class="size-1.5 shrink-0 rounded-full bg-(--color-accent)" aria-hidden="true" />
              {c}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-20" aria-labelledby="contact" data-reveal>
      <h2 id="contact" class="text-2xl">Get in touch</h2>
      <p class="mt-4 text-(--color-muted)">
        Open to marketing, design and content roles, and to game and XR collaborations.
      </p>
      <ContactForm />
      <div class="mt-8 flex flex-wrap gap-3">
        {
          socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="me noopener"
              class="rounded-full border border-white/12 px-6 py-3 text-sm font-medium text-(--color-muted) transition-colors duration-300 hover:border-white/25 hover:text-(--color-fg)"
            >
              {s.label}
            </a>
          ))
        }
      </div>
    </section>
  </div>
</Base>
