---
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import { getAllWork, disciplines } from '../../lib/collections';
import { pageSchema } from '../../lib/schema';

const work = await getAllWork();

const sections = [
  { ...disciplines.games, entries: work.games },
  { ...disciplines.writing, entries: work.writing },
  { ...disciplines.design, entries: work.design },
];
---

<Base
  title="Work"
  description="Marketing campaigns, social and video content, graphic design, and 3D and XR projects by Stuart May."
  schema={pageSchema('Work', '/work', 'Marketing campaigns, social and video content, graphic design, and 3D and XR projects by Stuart May.', 'CollectionPage')}
>
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
    <header class="mb-20 max-w-2xl" data-intro>
      <h1 class="text-4xl sm:text-5xl">Work</h1>
      <p class="mt-5 text-lg leading-relaxed text-(--color-muted)">
        Grouped by discipline. Marketing is in-house work for the brands I've worked with:
        campaigns, social content and video. Design mixes client pieces with coursework from my
        UCD Graphic Design diploma and degree, plus a few personal experiments. Games and XR covers
        my 3D and interactive work.
      </p>
    </header>

    <div class="flex flex-col gap-24">
      {
        sections.map((section) => (
          <section id={section.id} aria-labelledby={`${section.id}-heading`}>
            <SectionHeading
              id={`${section.id}-heading`}
              eyebrow={section.label}
              title={section.label}
              blurb={section.blurb}
              discipline={section.id}
            />
            {'note' in section && (
              <p class="glass -mt-4 mb-10 max-w-3xl rounded-2xl px-6 py-4 text-sm leading-relaxed text-(--color-muted)">
                {section.note}{' '}
                <a href="/about#contact" class="underline underline-offset-4 hover:text-(--color-fg)">
                  Get in touch
                </a>
              </p>
            )}
            <ProjectGrid
              entries={section.entries}
              emptyMessage={`${section.label} case studies are being written up.`}
            />
            {'banner' in section && (
              <div
                data-reveal
                data-discipline={section.id}
                class="glass mt-12 flex gap-4 rounded-2xl px-6 py-5 sm:gap-5 sm:px-8 sm:py-6"
              >
                <span class="accent-bg w-1 shrink-0 self-stretch rounded-full" aria-hidden="true" />
                <div>
                  <p class="text-lg font-medium sm:text-xl">{section.banner.title}</p>
                  {section.banner.detail && (
                    <p class="mt-2 text-sm leading-relaxed text-(--color-muted)">
                      {section.banner.detail}{' '}
                      {section.banner.href && (
                        <a
                          href={section.banner.href}
                          target="_blank"
                          rel="noopener"
                          class="underline underline-offset-4 hover:text-(--color-fg)"
                        >
                          {section.banner.linkLabel ?? 'Read more'}
                        </a>
                      )}
                    </p>
                  )}
                </div>
              </div>
            )}
          </section>
        ))
      }
    </div>
  </div>
</Base>
