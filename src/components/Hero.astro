---
import { site } from '../config';
import { disciplines } from '../lib/collections';
---

<section class="relative mx-auto max-w-6xl px-4 pb-20 pt-20 sm:px-6 sm:pb-28 sm:pt-32">
  <p
    data-reveal
    class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/12 bg-white/4 px-3.5 py-1.5 text-xs text-(--color-muted) backdrop-blur-sm"
  >
    <span class="size-1.5 rounded-full bg-(--color-accent)" aria-hidden="true"></span>
    Currently studying MSc Game Development &amp; XR
  </p>

  <h1 data-reveal data-delay="1" class="max-w-4xl text-4xl leading-[1.08] sm:text-6xl lg:text-7xl">
    I design the things people see —
    <span
      class="bg-gradient-to-r from-(--color-design) via-(--color-accent) to-(--color-writing) bg-clip-text text-transparent"
      >and build the ones they play.</span
    >
  </h1>

  <p data-reveal data-delay="2" class="mt-7 max-w-2xl text-lg leading-relaxed text-(--color-muted)">
    {site.name} — a marketing graduate and certified graphic designer moving into game and XR
    development. Brand and campaign work, now pointed at interactive things.
  </p>

  <div data-reveal data-delay="3" class="mt-10 flex flex-wrap gap-3">
    <a
      href="/work"
      class="glass rounded-full px-6 py-3 text-sm font-medium transition-[transform,background-color] duration-300 hover:-translate-y-0.5 hover:bg-white/10"
    >
      See the work
    </a>
    <a
      href="/about"
      class="rounded-full border border-white/12 px-6 py-3 text-sm font-medium text-(--color-muted) transition-colors duration-300 hover:border-white/25 hover:text-(--color-fg)"
    >
      About me
    </a>
  </div>

  <ul data-reveal data-delay="4" class="mt-16 grid gap-4 sm:grid-cols-3">
    {
      Object.values(disciplines).map((d) => (
        <li class="glass rounded-xl p-5" data-discipline={d.id}>
          <p class="accent-text mb-2 text-xs font-medium uppercase tracking-[0.16em]">{d.label}</p>
          <p class="text-sm leading-relaxed text-(--color-muted)">{d.blurb}</p>
        </li>
      ))
    }
  </ul>
</section>
