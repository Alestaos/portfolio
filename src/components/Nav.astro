---
import { nav, site } from '../config';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const base = href.split('#')[0];
  return base === '/' ? path === '/' : path === base || path.startsWith(`${base}/`);
};

// About is a plain text link; the discipline and Results links are pills.
// Archive is a pill too, but sits outside the pill row so that, below sm, it
// shares the top row with About: five pills don't fit across a phone.
const pills = nav.filter((item) => item.href !== '/about' && item.href !== '/design/deviantart-era');
const archive = nav.find((item) => item.href === '/design/deviantart-era');
const about = nav.find((item) => item.href === '/about');
const link =
  'block rounded-full whitespace-nowrap text-(--color-muted) transition-colors hover:bg-white/5 hover:text-(--color-fg) aria-[current=page]:bg-white/8 aria-[current=page]:text-(--color-fg)';
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-(--color-ink) focus:px-5 focus:py-2.5 focus:text-sm"
>
  Skip to content
</a>

<header class="glass-bar sticky top-0 z-40">
  {/* Below sm the pills drop to their own full-width row under the name, with
      About beside the name, so nothing pushes a 320px phone sideways. */}
  <nav
    aria-label="Primary"
    class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-2 gap-y-1.5 px-4 py-2.5 sm:flex-nowrap sm:px-6 sm:py-3"
  >
    <a
      href="/"
      class="mr-auto font-[family-name:var(--font-display)] text-base font-semibold tracking-tight transition-opacity hover:opacity-70"
    >
      {site.name}
    </a>

    <ul class="order-last flex w-full items-center justify-between gap-1 text-[0.8125rem] max-[22.5rem]:text-xs sm:order-none sm:w-auto sm:gap-2 sm:text-sm">
      {
        pills.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class={`${link} border border-white/12 bg-white/4 px-2.5 py-2 max-[22.5rem]:px-2 sm:px-3 sm:py-1.5`}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    {
      archive && (
        <a
          href={archive.href}
          aria-current={isCurrent(archive.href) ? 'page' : undefined}
          class={`${link} border border-white/12 bg-white/4 px-2.5 py-1.5 text-[0.8125rem] max-[22.5rem]:text-xs sm:px-3 sm:text-sm`}
        >
          {archive.label}
        </a>
      )
    }

    {
      about && (
        <a
          href={about.href}
          aria-current={isCurrent(about.href) ? 'page' : undefined}
          class={`${link} -mr-2 px-3 py-2 text-sm sm:mr-0 sm:py-1.5`}
        >
          {about.label}
        </a>
      )
    }
  </nav>
</header>
